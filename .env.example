# Populate with `npx neon env pull` (or copy from the Neon dashboard). Never commit .env.local.

# --- Neon Postgres ---
# Pooled connection string. Used by Drizzle at runtime and by drizzle-kit.
DATABASE_URL=
# Direct (unpooled) connection. Needed for migrations and anything holding a session.
DATABASE_URL_UNPOOLED=
# Branch the env above was pulled from; informational.
NEON_BRANCH=

# --- Neon Object Storage (S3-compatible) ---
# Bucket "assets" is declared in neon.ts (private; reads go through signed URLs).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# --- Clerk (Google sign-in) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Gemini (image generation + vision) ---
GEMINI_API_KEY=
# Image model (Nano Banana family) and vision model used by the pipeline.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_VISION_MODEL=gemini-3.6-flash
# gemini (default) | paste — paste composites deterministically without any API (CI uses it).
GENERATION_MODE=gemini
# Max generation attempts per master per rolling 24h, across all their games. Every attempt row
# counts, including the retries inside one loop (up to 3 per click). Defaults to 20 if unset.
GENERATION_DAILY_CAP=20

# --- Integration tests ---
# A disposable Neon branch. Tests TRUNCATE every table here. Never the dev or prod branch.
TEST_DATABASE_URL=
# Direct (unpooled) connection to the same branch. Used by `drizzle-kit migrate` in CI.
TEST_DATABASE_URL_UNPOOLED=

# --- Seed / E2E ---
# Clerk user id that owns the seeded games (`npm run seed`). Defaults to a fake "seed-master".
SEED_MASTER_ID=
# Optional: a dedicated Clerk test user for Playwright (never a real account; global setup may set its primary email).
# When unset, global setup finds or creates e2e@spotted.test.
E2E_CLERK_USER_ID=
